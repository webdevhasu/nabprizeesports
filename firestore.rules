rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'nabprize.official@gmail.com';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isWithdrawalOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // ─── USERS ───
    match /users/{uid} {
      // Profiles contain private data (email, wallet, notification tokens and game IDs).
      // Public leaderboard data is exposed through matchResults instead.
      allow read: if isAdmin() || isOwner(uid);

      // On signup / account setup: wallet balance, wins, kills must start at 0
      allow create: if isOwner(uid)
        && request.resource.data.walletBalance == 0
        && request.resource.data.totalWins == 0
        && request.resource.data.totalKills == 0
        && request.resource.data.tournamentsPlayed == 0
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false);

      // On profile updates:
      // - Admin can update any field (including adding funds, banning, awarding prizes)
      // - Normal user CAN NEVER INCREASE their wallet balance! Only decrement for join/withdraw
      // - Normal user CANNOT change isBanned, email, totalWins, totalKills, createdAt
      allow update: if isAdmin() || (
        isOwner(uid)
        // A player may edit only their profile/notification fields.
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fullName', 'username', 'games', 'fcmTokens', 'photoURL'])
        // Wallet balance can NEVER be changed by a player console
        && request.resource.data.walletBalance == resource.data.walletBalance
        // Administrative/ledger fields are immutable by users
        && request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
        && request.resource.data.get('totalWins', 0) == resource.data.get('totalWins', 0)
        && request.resource.data.get('totalKills', 0) == resource.data.get('totalKills', 0)
        && request.resource.data.get('tournamentsPlayed', 0) == resource.data.get('tournamentsPlayed', 0)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email
      );

      allow delete: if isAdmin();

      // ─── NOTIFICATIONS (subcollection) ───
      match /notifications/{notifId} {
        allow get: if isOwner(uid) || isAdmin();
        allow list: if isAdmin() || (isOwner(uid) && request.query.limit != null && request.query.limit <= 100);
        allow create: if isAdmin();
        // User can only mark as read; cannot modify content or inject fake alerts
        allow update: if (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      // ─── TOURNAMENTS PLAYED (subcollection) ───
      match /tournamentsPlayed/{tpId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // ─── TOURNAMENTS ───
    match /tournaments/{tournamentId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit != null && request.query.limit <= 100);
      allow create, delete: if isAdmin();

      // Admin can update all fields (room ID, pass, status, prizes)
      // Users can ONLY increment slotsFilled by exactly 1 during valid join flow
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotsFilled'])
        && request.resource.data.slotsFilled == resource.data.slotsFilled + 1
        && resource.data.slotsFilled < resource.data.maxSlots
        // The slot increment must be in the same atomic write as this user's
        // registration document; a console-only increment is rejected.
        && getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/players/$(request.auth.uid)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/players/$(request.auth.uid)).data.status == 'registered'
      );

      // Players subcollection
      match /players/{playerId} {
        allow get: if isAuthenticated();
        allow list: if isAdmin() || (isAuthenticated() && request.query.limit != null && request.query.limit <= 100);
        // Player can only join themselves and MUST atomically deduct wallet if paid
      allow create: if isAdmin() || (
          isAuthenticated()
          && request.auth.uid == playerId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'registered'
          && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status == 'upcoming'
          && (
             get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('registrationCharge', 0) == 0
             || 
             getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.walletBalance == 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.walletBalance - get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('registrationCharge', 0)
          )
        );
        allow update, delete: if isAdmin();
      }

      // Room details subcollection (secure)
      match /roomDetails/{docId} {
        allow read: if isAdmin() || (isAuthenticated() && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/players/$(request.auth.uid)));
        allow create, update, delete: if isAdmin();
      }
    }

    // ─── TOURNAMENT TEMPLATES ───
    match /tournamentTemplates/{templateId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit != null && request.query.limit <= 1000;
      allow create, update, delete: if isAdmin();
    }

    // ─── MATCH RESULTS ───
    match /matchResults/{resultId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit != null && request.query.limit <= 100);
      // CRITICAL: Only admin can declare winners, fraggers, or submit scores
      allow create, update, delete: if isAdmin();
    }

    // ─── TRANSACTIONS ───
    match /transactions/{userId}/{document=**} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isOwner(userId) && request.query.limit != null && request.query.limit <= 100);
      // Ledger entries are server/admin-owned. A user must never be able to
      // create a fake credit/debit from DevTools.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Server-maintained financial summary. Players never receive this data.
    match /platformLedger/{ledgerId} {
      allow read, write: if isAdmin();
    }
    match /platformLedger/{ledgerId}/{document=**} {
      allow read, write: if isAdmin();
    }

    // ─── WITHDRAWALS ───
    match /withdrawals/{withdrawalId} {
      allow get: if isWithdrawalOwner() || isAdmin();
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit != null && request.query.limit <= 100);
      // On create: MUST be pending, valid limits, user cannot pre-approve
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 200
        && request.resource.data.amount <= 50000
        && request.resource.data.method in ['jazzcash', 'easypaisa']
        && request.resource.data.accountNumber is string
        && request.resource.data.accountNumber.size() >= 10
        // Atomically enforce wallet deduction
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.walletBalance == 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.walletBalance - request.resource.data.amount;
      // CRITICAL: Only admin can approve or reject
      allow update, delete: if isAdmin();
    }

    // ─── DEPOSITS ───
    match /deposits/{depositId} {
      allow get: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit != null && request.query.limit <= 100);
      // On create: User can only create their own deposit in pending status with valid amount
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 30
        && request.resource.data.amount <= 20000
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() >= 0
        && request.resource.data.transactionId.size() <= 100
        && request.resource.data.senderNumber is string
        && request.resource.data.senderNumber.matches('03[0-9]{9}')
        && request.resource.data.paymentMethod in ['jazzcash', 'easypaisa'];
      // CRITICAL: Only admin can approve or reject deposits
      allow update, delete: if isAdmin();
    }

    // ─── REPORTS ───
    match /reports/{reportId} {
      allow get: if isAdmin() || (isAuthenticated() && resource.data.reporterUid == request.auth.uid);
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit != null && request.query.limit <= 100);
      // Rate-limiting / anti-abuse: prevent infinite payload spam
      // All report creation goes through submitReport, which atomically
      // enforces the five-per-user-per-day limit.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── REVIEWS ───
    match /reviews/{reviewId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit != null && request.query.limit <= 100);
      // Reviews go through submitReview callable, which checks eligibility
      // and the monthly limit server-side. Direct client/console writes are blocked.
      allow create: if isAdmin();
      // Reviews are immutable
      allow update, delete: if isAdmin();
    }
  }
}
