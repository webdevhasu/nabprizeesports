rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'nabprize.official@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Users - owner can read/write, admin can write (for winner reward credits, stats increment, refunding rejected withdrawals, banning/unbanning)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Notifications - owner can read, anyone authenticated can create (for admin/system)
      match /notifications/{notifId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow create: if request.auth != null;
        allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }
    }

    // Tournaments - anyone authenticated can read, only admin writes
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow create: if request.auth != null;

      // Players subcollection
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // Tournament Templates & Presets (Admin only)
    match /tournamentTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // Match Results - authenticated read/write
    match /matchResults/{resultId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Transactions - owner can read/write, admin can write
    match /transactions/{userId}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null;
    }

    // Withdrawals - owner can read/create, admin-only update
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null;
    }

    // Reports - authenticated can create and read, admin can update
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Reviews - authenticated can create and read
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
