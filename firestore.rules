rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'nabprize.official@gmail.com';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isWithdrawalOwner() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ─── USERS ───
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // Owner can update own profile (username, gameIDs, fcmTokens, walletBalance)
      // NOTE: walletBalance can be tampered via console — needs Cloud Functions for full protection
      allow update: if isOwner(uid) || isAdmin();

      // ─── NOTIFICATIONS (subcollection) ───
      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        // Owner can mark as read / delete own notifications
        allow update: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }

      // ─── TOURNAMENTS PLAYED (subcollection) ───
      match /tournamentsPlayed/{tpId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isAdmin();
      }
    }

    // ─── TOURNAMENTS ───
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      // Admin can update all fields; users can only update slotsFilled (join flow)
      allow update: if isAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotsFilled']));

      // Players subcollection
      match /players/{playerId} {
        allow read: if request.auth != null;
        // Player can join (create own registration), admin can manage all
        allow create: if request.auth != null && request.auth.uid == playerId;
        allow update, delete: if isAdmin();
      }
    }

    // ─── TOURNAMENT TEMPLATES ───
    match /tournamentTemplates/{templateId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ─── MATCH RESULTS ───
    match /matchResults/{resultId} {
      allow read: if request.auth != null;
      // CRITICAL: Only admin can declare winners and submit fraggers
      allow create, update, delete: if isAdmin();
    }

    // ─── TRANSACTIONS ───
    match /transactions/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    // ─── WITHDRAWALS ───
    match /withdrawals/{withdrawalId} {
      allow read: if isWithdrawalOwner() || isAdmin();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // CRITICAL: Only admin can approve/reject
      allow update: if isAdmin();
    }

    // ─── DEPOSITS ───
    match /deposits/{depositId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // CRITICAL: Only admin can approve/reject deposits
      allow update, delete: if isAdmin();
    }

    // ─── REPORTS ───
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Only admin can update status
      allow update, delete: if isAdmin();
    }

    // ─── REVIEWS ───
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Reviews are immutable
    }
  }
}
